# Server Port & Environment
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database Connection
MONGO_URI=your_mongodb_atlas_connection_string

# JWT Authentication Secrets
JWT_SECRET=your_secret_jwt_access_token_key_here
JWT_REFRESH_SECRET=your_secret_jwt_refresh_token_key_here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary Storage (Resume PDFs & Recruiter Avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_RESUME_FOLDER=shortlist-ai/resumes
CLOUDINARY_AVATAR_FOLDER=shortlist-ai/avatars

# AI / Groq LLM Configuration
# Recommended for fast demo response: openai/gpt-oss-20b (or openai/gpt-oss-120b for queued inference)
GROQ_API_KEY=your_groq_api_key
AI_MODEL=openai/gpt-oss-20b

# Transactional Email Option A: Brevo HTTPS REST API (Recommended for production on Render/Railway)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com

# Transactional Email Option B: SMTP (Nodemailer fallback for local development)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="Shortlist AI" <your_gmail_address@gmail.com>
